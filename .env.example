# Gemini API Credentials (used by the Code Synapse ADK web agent)
# Create a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# NVIDIA NIM API Credentials (used by the separate RAG indexing pipeline)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Pinecone Vector Database Credentials
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_INDEX_NAME=code-synapse
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# RAG Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4

# Windows UTF-8 flag
PYTHONUTF8=1
